# Copy this file to .env.local, then add a real Resend key and verified sender.
# The contact and admission forms deliver to admission@icaremedicalcollege.com.
RESEND_API_KEY=re_your_resend_api_key
# Replace with an address on a domain verified in Resend.
CONTACT_FROM_EMAIL=ICARE Website <website@your-verified-domain.com>
